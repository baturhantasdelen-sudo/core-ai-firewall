# Nexus Quantum Guard — production / local compose ortam degiskenleri
# Kullanim: cp .env.example .env  (gercek .env git'e eklenmez)

# --- Zorunlu (production) ---
DOCKER_IMAGE=your-dockerhub-user/nexus-quantum-guard:latest

# API kimlik dogrulama — production'da mutlaka degistirin:
#   openssl rand -hex 32
# Yerel gelistirme icin kod varsayilani: nexus-dev-test-key
API_KEY_SECRET=REPLACE_WITH_STRONG_RANDOM_SECRET

# --- Rate limiting (API key basina, in-memory — tek worker) ---
RATE_LIMIT_REQUESTS=60
RATE_LIMIT_WINDOW_SECONDS=60

# --- Cloudflare HTTPS tuneli (opsiyonel) ---
CLOUDFLARE_TUNNEL_TOKEN=

# --- PostHog Analytics (landing page /analytics-config.js) ---
POSTHOG_API_KEY=phc_your_posthog_project_key
POSTHOG_HOST=https://us.i.posthog.com

# --- Cloudflare Web Analytics beacon (opsiyonel) ---
# Cloudflare Dashboard → Web Analytics → Manage site → JS snippet token
CLOUDFLARE_WEB_ANALYTICS_TOKEN=

# --- Entegrasyon testleri / dogrulama ---
PROD_PUBLIC_URL=https://your-subdomain.example.com
