default_platform(:ios)

NEXUS_APP_IDENTIFIER = "com.nexusshield.guard"

# Fastlane actions (match, upload_to_app_store, etc.) auto-map APP_STORE_CONNECT_API_KEY_PATH
# to the api_key_path option. Passing api_key: at the same time raises:
# "Unresolved conflict between options: 'api_key_path' and 'api_key'".
def nexus_prepare_app_store_connect_api_key_env!
  ENV.delete("APP_STORE_CONNECT_API_KEY_PATH")
end

def nexus_normalize_asc_env!
  ENV["APP_STORE_CONNECT_API_KEY_KEY_ID"] = ENV["APP_STORE_CONNECT_API_KEY_KEY_ID"].to_s.strip
  ENV["APP_STORE_CONNECT_API_KEY_KEY_ID"] = ENV["ASC_KEY_ID"].to_s.strip if ENV["APP_STORE_CONNECT_API_KEY_KEY_ID"].empty?

  ENV["APP_STORE_CONNECT_API_KEY_ISSUER_ID"] = ENV["APP_STORE_CONNECT_API_KEY_ISSUER_ID"].to_s.strip
  ENV["APP_STORE_CONNECT_API_KEY_ISSUER_ID"] = ENV["ASC_ISSUER_ID"].to_s.strip if ENV["APP_STORE_CONNECT_API_KEY_ISSUER_ID"].empty?

  key_content = ENV["APP_STORE_CONNECT_API_KEY_KEY"].to_s.strip
  key_content = ENV["ASC_KEY_CONTENT"].to_s.strip if key_content.empty?
  if key_content.empty?
    key_file = File.expand_path("keys/AuthKey.p8", __dir__)
    key_content = File.read(key_file).strip if File.exist?(key_file) && File.size?(key_file).to_i.positive?
  end
  ENV["APP_STORE_CONNECT_API_KEY_KEY"] = key_content unless key_content.empty?

  nexus_prepare_app_store_connect_api_key_env!
end

def nexus_app_store_connect_api_key
  nexus_normalize_asc_env!

  key_id = ENV.fetch("APP_STORE_CONNECT_API_KEY_KEY_ID")
  issuer_id = ENV.fetch("APP_STORE_CONNECT_API_KEY_ISSUER_ID")

  key_content = ENV["APP_STORE_CONNECT_API_KEY_KEY"]
  if key_content && !key_content.strip.empty?
    return app_store_connect_api_key(
      key_id: key_id,
      issuer_id: issuer_id,
      key_content: key_content,
      is_key_content_base64: ENV["APP_STORE_CONNECT_API_KEY_IS_BASE64"] == "true",
      duration: 1200,
      in_house: false
    )
  end

  UI.user_error!(
    "App Store Connect API key contents missing. Set APP_STORE_CONNECT_API_KEY_KEY (.p8 contents)."
  )
end

def nexus_team_id
  team = CredentialsManager::AppfileConfig.try_fetch_value(:team_id) || ENV["FASTLANE_TEAM_ID"]
  UI.user_error!("FASTLANE_TEAM_ID (or team_id in Appfile) is required for match and code signing.") if team.to_s.strip.empty?

  team
end

def nexus_match_git_url
  url = ENV["MATCH_GIT_URL"].to_s.strip
  if url.empty?
    UI.user_error!(
      "MATCH_GIT_URL is required. Set the GitHub Actions secret to your private match repo " \
        "(example: https://github.com/YOUR_ORG/nexusshield-ios-certificates.git)."
    )
  end
  unless url.match?(%r{\A(https://|git@|ssh://)}i)
    UI.user_error!("MATCH_GIT_URL must be an https://, git@, or ssh:// URL. Current value: #{url}")
  end
  unless url.match?(%r{github\.com[/:][A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+}i)
    UI.user_error!(
      "MATCH_GIT_URL must be the private match certificates repo on GitHub " \
        "(example: https://github.com/YOUR_ORG/nexusshield-ios-certificates.git). " \
        "Got: #{nexus_match_git_url_for_logs(url)}"
    )
  end

  url
end

def nexus_match_git_url_for_logs(url)
  url.gsub(%r{https://[^/@]+@}i, "https://***@")
end

def nexus_match_git_basic_authorization
  auth = ENV["MATCH_GIT_BASIC_AUTHORIZATION"].to_s.strip
  return auth unless auth.empty?

  pat = ENV["MATCH_GITHUB_PAT"].to_s.strip
  return Base64.strict_encode64("x-access-token:#{pat}") unless pat.empty?

  nil
end

def nexus_match_git_auth_configured?(git_url)
  return true if git_url.match?(%r{https://[^/@]+@}i)

  !nexus_match_git_basic_authorization.to_s.empty?
end

def nexus_match_git_branch
  branch = ENV["MATCH_GIT_BRANCH"].to_s.strip
  branch = "main" if branch.empty?
  branch
end

def nexus_validate_match_env!
  UI.user_error!("MATCH_PASSWORD is required for match.") if ENV["MATCH_PASSWORD"].to_s.strip.empty?
  nexus_match_git_url
  UI.user_error!("FASTLANE_TEAM_ID is required for match.") if ENV["FASTLANE_TEAM_ID"].to_s.strip.empty?
end

def nexus_persist_ci_keychain_env!
  return unless is_ci

  keychain_name = ENV["MATCH_KEYCHAIN_NAME"]
  keychain_password = ENV["MATCH_KEYCHAIN_PASSWORD"]
  return if keychain_name.to_s.empty? || keychain_password.to_s.empty?

  ios_root = File.expand_path("..", __dir__)
  env_path = File.join(ios_root, ".ci-keychain.env")
  File.write(
    env_path,
    <<~ENV
      MATCH_KEYCHAIN_NAME=#{keychain_name}
      MATCH_KEYCHAIN_PASSWORD=#{keychain_password}
    ENV
  )
  env_path
end

def nexus_ensure_match_keychain!
  return unless is_ci

  require "securerandom"

  keychain_name = ENV["MATCH_KEYCHAIN_NAME"].to_s.strip
  keychain_password = ENV["MATCH_KEYCHAIN_PASSWORD"].to_s.strip
  keychain_name = "nexusshield-ci.keychain-db" if keychain_name.empty?
  keychain_password = SecureRandom.hex(32) if keychain_password.empty?

  ENV["MATCH_KEYCHAIN_NAME"] = keychain_name
  ENV["MATCH_KEYCHAIN_PASSWORD"] = keychain_password

  begin
    delete_keychain(name: keychain_name)
  rescue StandardError
    # Keychain may not exist on first CI run.
  end
  create_keychain(
    name: keychain_name,
    password: keychain_password,
    default_keychain: true,
    unlock: true,
    timeout: 3600,
    lock_when_sleeps: false
  )

  nexus_refresh_ci_keychain_search_list!
end

def nexus_ci_keychain_file_path
  name = ENV["MATCH_KEYCHAIN_NAME"].to_s.strip
  UI.user_error!("MATCH_KEYCHAIN_NAME is missing on CI.") if name.empty?

  return File.expand_path(name) if name.start_with?("~") || name.start_with?("/")

  File.expand_path("~/Library/Keychains/#{name}")
end

def nexus_refresh_ci_keychain_search_list!
  return unless is_ci

  keychain_password = ENV["MATCH_KEYCHAIN_PASSWORD"].to_s.strip
  keychain_path = nexus_ci_keychain_file_path

  sh("security", "unlock-keychain", "-p", keychain_password, keychain_path) unless keychain_password.empty?
  sh("security", "set-keychain-settings", "-t", "3600", "-u", keychain_path)
  sh("security", "default-keychain", "-s", keychain_path)

  login_keychain = File.expand_path("~/Library/Keychains/login.keychain-db")
  search_list = [keychain_path]
  search_list << login_keychain if File.exist?(login_keychain)
  sh("security", "list-keychains", "-s", *search_list)
end

def nexus_ci_keychain_has_distribution_identity?
  return false unless is_ci

  output = sh("security", "find-identity", "-v", "-p", "codesigning", nexus_ci_keychain_file_path, log: false)
  output.match?(/Apple Distribution|iPhone Distribution/)
rescue StandardError
  false
end

def nexus_match_readonly_for_run?
  return false unless is_ci
  return false if ENV["NEXUS_MATCH_FORCE_GENERATE"] == "true"
  return false if ENV["NEXUS_MATCH_READONLY"] == "false"
  return true if ENV["NEXUS_MATCH_READONLY"].to_s.strip.empty?
  ENV["NEXUS_MATCH_READONLY"] == "true"
end

def nexus_match_bootstrap_failure?(error)
  msg = error.message.to_s
  msg.match?(/readonly|No code signing identity|Could not find a valid code signing identity|valid code signing identity for distribution/i)
end

def nexus_build_match_params(api_key:, team_id:, match_git_url:, match_branch:, git_auth:, readonly:)
  params = {
    type: "appstore",
    readonly: readonly,
    api_key: api_key,
    app_identifier: NEXUS_APP_IDENTIFIER,
    git_url: match_git_url,
    git_branch: match_branch,
    team_id: team_id,
    storage_mode: "git",
    skip_confirmation: true,
    skip_docs: true,
    verbose: is_ci,
    shallow_clone: true,
    include_all_certificates: true,
    force_for_new_devices: false
  }
  params[:git_basic_authorization] = git_auth if git_auth && !git_auth.empty?
  params
end

def nexus_run_match_with_readonly_fallback!(match_params)
  readonly = match_params[:readonly]
  begin
    nexus_run_match!(match_params)
  rescue StandardError => e
    bootstrap_allowed =
      is_ci &&
      readonly &&
      ENV["NEXUS_MATCH_DISABLE_BOOTSTRAP"] != "true" &&
      nexus_match_bootstrap_failure?(e)

    unless bootstrap_allowed
      UI.error("match failed (readonly=#{readonly}): #{e.message}")
      raise e
    end

    UI.important(
      "match readonly failed (likely missing certs in match git repo). " \
        "Retrying once with readonly: false to bootstrap via App Store Connect API. " \
        "Ensure MATCH_GITHUB_PAT can push to the match repo."
    )
    retry_params = match_params.merge(readonly: false)
    nexus_run_match!(retry_params)
  end
end

def nexus_unlock_ci_keychain!
  return unless is_ci

  ios_root = File.expand_path("..", __dir__)
  env_path = File.join(ios_root, ".ci-keychain.env")
  UI.user_error!(".ci-keychain.env missing. Run fastlane ci_keychain before sign/build.") unless File.exist?(env_path)

  env_path.each_line do |line|
    key, value = line.strip.split("=", 2)
    next if key.nil? || value.nil?

    ENV[key] = value
  end

  nexus_refresh_ci_keychain_search_list!
end

def nexus_match_keychain_name_for_fastlane
  ENV["MATCH_KEYCHAIN_NAME"].to_s.strip
end

def nexus_bind_ci_keychain_for_match!
  return unless is_ci

  name = nexus_match_keychain_name_for_fastlane
  password = ENV["MATCH_KEYCHAIN_PASSWORD"].to_s.strip
  UI.user_error!("MATCH_KEYCHAIN_NAME is missing before match on CI.") if name.empty?
  UI.user_error!("MATCH_KEYCHAIN_PASSWORD is missing before match on CI.") if password.empty?

  keychain_path = nexus_ci_keychain_file_path
  unless File.exist?(keychain_path)
    UI.user_error!(
      "CI keychain not found at #{keychain_path}. Run fastlane ci_keychain before sign/match."
    )
  end

  ENV["MATCH_KEYCHAIN_NAME"] = name
  ENV["MATCH_KEYCHAIN_PASSWORD"] = password
  nexus_refresh_ci_keychain_search_list!

  UI.message("CI keychain for match: name=#{name}, path=#{keychain_path}")
end

def nexus_apply_ci_keychain_to_match_params!(match_params)
  return unless is_ci

  name = nexus_match_keychain_name_for_fastlane
  password = ENV["MATCH_KEYCHAIN_PASSWORD"].to_s.strip
  return if name.empty? || password.empty?

  # Must match create_keychain(name:) — not the absolute path — so match imports the private key correctly.
  match_params[:keychain_name] = name
  match_params[:keychain_password] = password
end

def nexus_run_match!(match_params)
  nexus_bind_ci_keychain_for_match! if is_ci
  nexus_apply_ci_keychain_to_match_params!(match_params)

  if is_ci
    UI.message("match keychain_name param: #{match_params[:keychain_name]}")
    pre = sh("security", "find-identity", "-v", "-p", "codesigning", nexus_ci_keychain_file_path, log: false)
    UI.message("Identities in CI keychain before match:\n#{pre}")
  end

  match(match_params)
end

def nexus_set_keychain_partition_list_for_codesign!
  return unless is_ci

  keychain_password = ENV["MATCH_KEYCHAIN_PASSWORD"].to_s.strip
  return if keychain_password.empty?

  sh(
    "security", "set-key-partition-list",
    "-S", "apple-tool:,apple:,codesign:",
    "-s", "-k", keychain_password,
    nexus_ci_keychain_file_path
  )
rescue StandardError => e
  UI.important("set-key-partition-list skipped: #{e.message}")
end

def nexus_assert_distribution_codesigning_identity!
  keychain_path = is_ci ? nexus_ci_keychain_file_path : nil
  search_args =
    if keychain_path
      ["security", "find-identity", "-v", "-p", "codesigning", keychain_path]
    else
      ["security", "find-identity", "-v", "-p", "codesigning"]
    end

  output = sh(*search_args, log: false)
  return if output.match?(/Apple Distribution|iPhone Distribution/)

  team = ENV["FASTLANE_TEAM_ID"].to_s.strip
  readonly = is_ci ? "true" : "false"
  UI.user_error!(
    "No Apple Distribution identity in keychain after match (readonly=#{readonly}).\n" \
      "The CI keychain (#{keychain_path || 'default'}) must contain the distribution private key imported by match.\n\n" \
      "Fix checklist:\n" \
      "  1) Verify the match git repo includes a valid App Store distribution cert + encrypted private key for team #{team.empty? ? '(set FASTLANE_TEAM_ID)' : team}.\n" \
      "  2) If Apple reports too many distribution certificates, revoke an unused cert in Developer portal, then on a trusted Mac run once: bundle exec fastlane match appstore (readonly false).\n" \
      "  3) Confirm CI exports MATCH_KEYCHAIN_NAME and MATCH_KEYCHAIN_PASSWORD to the fastlane build step.\n\n" \
      "security find-identity output:\n#{output}"
  )
end

def write_export_options_plist!(profile_name:, team_id:)
  ios_root = File.expand_path("..", __dir__)
  path = File.join(ios_root, "ExportOptions.plist")
  escaped_profile = profile_name.to_s.gsub("&", "&amp;").gsub("<", "&lt;").gsub(">", "&gt;")

  File.write(
    path,
    <<~PLIST
      <?xml version="1.0" encoding="UTF-8"?>
      <!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
      <plist version="1.0">
      <dict>
        <key>method</key>
        <string>app-store</string>
        <key>teamID</key>
        <string>#{team_id}</string>
        <key>signingStyle</key>
        <string>manual</string>
        <key>provisioningProfiles</key>
        <dict>
          <key>com.nexusshield.guard</key>
          <string>#{escaped_profile}</string>
        </dict>
        <key>uploadSymbols</key>
        <true/>
        <key>compileBitcode</key>
        <false/>
      </dict>
      </plist>
    PLIST
  )

  path
end

platform :ios do
  desc "Create/unlock ephemeral CI keychain (run before match on GitHub Actions)"
  lane :ci_keychain do
    nexus_validate_match_env!
    nexus_ensure_match_keychain! if is_ci
    ENV["NEXUS_CI_KEYCHAIN_READY"] = "true"
    nexus_persist_ci_keychain_env!
  end

  desc "match appstore — install certs/profiles (readonly on CI; unattended GitHub Actions)"
  lane :match_appstore do
    sign
  end

  desc "Install App Store distribution cert and profile (match appstore, readonly on CI)"
  lane :sign do
    nexus_normalize_asc_env!
    nexus_validate_match_env!
    if is_ci && ENV["NEXUS_CI_KEYCHAIN_READY"] != "true"
      ci_keychain
    else
      nexus_unlock_ci_keychain! if is_ci
    end

    api_key = nexus_app_store_connect_api_key
    team_id = nexus_team_id

    match_git_url = nexus_match_git_url
    unless nexus_match_git_auth_configured?(match_git_url)
      UI.user_error!(
        "Match git authentication is not configured. Set MATCH_GIT_BASIC_AUTHORIZATION, " \
          "MATCH_GITHUB_PAT, or embed a PAT in MATCH_GIT_URL " \
          "(https://x-access-token:TOKEN@github.com/ORG/certs.git)."
      )
    end

    UI.message("match git_url: #{nexus_match_git_url_for_logs(match_git_url)}")

    match_branch = nexus_match_git_branch
    UI.message("match git_branch: #{match_branch}")

    match_readonly = is_ci ? nexus_match_readonly_for_run? : false
    if is_ci && ENV["NEXUS_MATCH_FORCE_GENERATE"] == "true"
      UI.message("NEXUS_MATCH_FORCE_GENERATE=true — starting match with readonly: false")
      match_readonly = false
    end

    git_auth = nexus_match_git_basic_authorization
    match_params = nexus_build_match_params(
      api_key: api_key,
      team_id: team_id,
      match_git_url: match_git_url,
      match_branch: match_branch,
      git_auth: git_auth,
      readonly: match_readonly
    )

    nexus_run_match_with_readonly_fallback!(match_params)

    nexus_unlock_ci_keychain! if is_ci
    nexus_set_keychain_partition_list_for_codesign!
    nexus_assert_distribution_codesigning_identity!

    profiles = lane_context[SharedValues::MATCH_PROVISIONING_PROFILE_MAPPING] || {}
    profile_name = profiles[NEXUS_APP_IDENTIFIER]
    UI.user_error!("match did not return a provisioning profile for #{NEXUS_APP_IDENTIFIER}") if profile_name.to_s.empty?

    update_code_signing_settings(
      path: "Runner.xcodeproj",
      targets: ["Runner"],
      build_configurations: ["Release", "Profile"],
      bundle_identifier: NEXUS_APP_IDENTIFIER,
      profile_name: profile_name,
      code_sign_identity: "Apple Distribution",
      use_automatic_signing: false,
      team_id: team_id
    )

    update_project_team(
      path: "Runner.xcodeproj",
      teamid: team_id
    )

    write_export_options_plist!(profile_name: profile_name, team_id: team_id)

    ENV["NEXUS_SIGN_COMPLETED"] = "true"
    UI.success("match signing ready — profile: #{profile_name}, team: #{team_id}")
  end

  desc "CI keychain + match sign + Flutter release IPA (single unattended lane)"
  lane :build do
    if is_ci && ENV["NEXUS_CI_KEYCHAIN_READY"] != "true"
      ci_keychain
    else
      nexus_unlock_ci_keychain! if is_ci
    end

    sign unless ENV["NEXUS_SIGN_COMPLETED"] == "true"
    ENV["NEXUS_SIGN_COMPLETED"] = "true"
    nexus_unlock_ci_keychain! if is_ci
    nexus_set_keychain_partition_list_for_codesign! if is_ci
    nexus_assert_distribution_codesigning_identity! if is_ci

    export_plist = File.expand_path("../ExportOptions.plist", __dir__)
    UI.user_error!("ExportOptions.plist missing after sign.") unless File.exist?(export_plist)

    mobile_root = File.expand_path("../..", __dir__)
    Dir.chdir(mobile_root) do
      nexus_refresh_ci_keychain_search_list! if is_ci
      sh("flutter", "pub", "get")
      sh("flutter", "build", "ipa", "--release", "--export-options-plist=ios/ExportOptions.plist")
    end
  end

  desc "Unlock CI keychain before xcodebuild/flutter (GitHub Actions follow-up steps)"
  lane :nexus_ci_unlock_keychain do
    nexus_unlock_ci_keychain!
  end

  desc "Upload release IPA to App Store Connect (upload_to_app_store / deliver)"
  lane :deploy do
    nexus_normalize_asc_env!

    ios_root = File.expand_path("..", __dir__)
    ipa_glob = File.expand_path("../build/ios/ipa/*.ipa", ios_root)
    ipa_path = Dir[ipa_glob].max_by { |path| File.mtime(path) }

    UI.user_error!("IPA not found matching #{ipa_glob}. Run fastlane build or flutter build ipa first.") if ipa_path.nil?

    api_key = nexus_app_store_connect_api_key

    upload_to_app_store(
      api_key: api_key,
      ipa: ipa_path,
      skip_metadata: true,
      skip_screenshots: true,
      submit_for_review: false,
      run_precheck_before_submit: false,
      precheck_include_in_app_purchases: false
    )
  end

  desc "sign, build IPA, upload to App Store Connect"
  lane :release do
    build
    deploy
  end

  desc "Alias for deploy"
  lane :beta do
    deploy
  end
end
