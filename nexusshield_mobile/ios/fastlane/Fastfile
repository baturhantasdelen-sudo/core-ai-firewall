default_platform(:ios)

platform :ios do
  desc "Upload release IPA to TestFlight (pilot)"
  lane :beta do
    ios_root = File.expand_path("..", __dir__)
    ipa_glob = File.expand_path("../build/ios/ipa/*.ipa", ios_root)
    ipa_path = Dir[ipa_glob].max_by { |path| File.mtime(path) }

    UI.user_error!("IPA not found matching #{ipa_glob}. Run flutter build ipa --release first.") if ipa_path.nil?

    api_key = app_store_connect_api_key(
      key_id: ENV.fetch("APP_STORE_CONNECT_API_KEY_KEY_ID"),
      issuer_id: ENV.fetch("APP_STORE_CONNECT_API_KEY_ISSUER_ID"),
      key_filepath: ENV.fetch("APP_STORE_CONNECT_API_KEY_PATH"),
      duration: 1200,
      in_house: false
    )

    pilot(
      api_key: api_key,
      ipa: ipa_path,
      skip_waiting_for_build_processing: true
    )
  end
end
