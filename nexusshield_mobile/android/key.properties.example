# Copy to android/key.properties (gitignored) or export the env vars below.
# Production upload keystore path (CI writes the same path from ANDROID_KEYSTORE_BASE64):
#   android/app/upload-keystore.jks
#
# Generate once:
#   keytool -genkey -v -keystore android/app/upload-keystore.jks -keyalg RSA -keysize 2048 -validity 10000 -alias upload-alias

storePassword=YOUR_STORE_PASSWORD
keyPassword=YOUR_KEY_PASSWORD
keyAlias=upload-alias
storeFile=app/upload-keystore.jks

# GitHub Actions / CI environment variables:
# ANDROID_KEYSTORE_BASE64        — base64(upload-keystore.jks), single line
# ANDROID_KEYSTORE_PASSWORD
# ANDROID_KEYSTORE_ALIAS         — e.g. upload-alias
# ANDROID_KEY_PASSWORD
# ANDROID_KEYSTORE_PATH          — optional absolute path (CI sets automatically)
# ANDROID_KEY_ALIAS              — optional alias of ANDROID_KEYSTORE_ALIAS
