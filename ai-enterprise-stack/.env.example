# Cloud LLM credentials (required for NexusShield and ResoNet cloud routing)
OPENAI_API_KEY=sk-your-openai-api-key

# Optional overrides
OPENAI_BASE_URL=https://api.openai.com/v1
DEFAULT_MODEL=gpt-4o-mini

# Ollama on host machine (Docker Desktop / Linux host-gateway)
OLLAMA_BASE_URL=http://host.docker.internal:11434/v1
OLLAMA_MODEL=llama3.2

# Telemetry & observability
TELEMETRY_DB_PATH=data/telemetry.db
LOG_LEVEL=INFO

# Dashboard mount mode
# false (recommended local dev): run Streamlit separately → http://localhost:8501
# true  (Docker / single-port):   proxied at http://localhost:8080/dashboard/
STREAMLIT_ENABLED=false

# V2 features
NEXUS_OUTPUT_GUARD_ENABLED=true
RESONET_COMPRESSION_TOKEN_THRESHOLD=200
RESONET_USE_LLMLINGUA=false
GRID_CARBON_REGION=global
