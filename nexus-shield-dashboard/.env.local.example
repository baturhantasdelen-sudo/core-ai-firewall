# Supabase (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# Stripe (Developers → API keys / Webhooks)
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_signing_secret
STRIPE_PRO_MONTHLY_PRICE_ID=price_your_monthly_59_usd
STRIPE_PRO_YEARLY_PRICE_ID=price_your_yearly_588_usd
# Legacy alias for monthly price ID
STRIPE_PRO_PRICE_ID=

# Public web app URL — marketing + dashboard (NOT the API subdomain)
# Examples: https://nexusshield.ai | https://app.nexusshield.ai
# Docs routes like /docs/benchmark must use this origin — never api.nexusshield.ai
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Backend Shield FastAPI — server-side proxy only (/api/proof-center, /api/sandbox, etc.)
NEXUS_SHIELD_API_URL=https://api.nexusshield.ai

# GitHub App (Settings → Developer settings → GitHub Apps → your app)
GITHUB_WEBHOOK_SECRET=your_github_app_webhook_secret
GITHUB_APP_ID=your_github_app_id
GITHUB_APP_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----\n"
NEXT_PUBLIC_GITHUB_APP_SLUG=your-github-app-slug

# GitHub PAT — private vulnerability reporting (portal submissions)
GITHUB_TOKEN=ghp_your_github_pat
# GH_PAT=ghp_your_github_pat

# Resend — outbound disclosure / advisory email dispatcher
RESEND_API_KEY=re_your_resend_api_key
OUTBOUND_FROM_EMAIL="Nexus Shield Security <info@nexusshield.ai>"
# Resend verified domain sender only (live trojan campaign)
# Route all batch emails to one inbox (recommended for testing before live outreach)
DISCLOSURE_OUTBOUND_RECIPIENT=security@nexusshield.ai
# Trojan outreach phased dispatcher (scripts/dispatch_outreach_campaign.py --send)
TROJAN_CAMPAIGN_RECIPIENT=security@nexusshield.ai
NEXUS_VERIFY_BASE_URL=https://api.nexusshield.ai/verify
NEXUS_PLAYGROUND_URL=https://nexus-shield-dashboard.vercel.app/#attack-simulator

# Portal-based disclosure intake
N8N_VDP_WEBHOOK_URL=
DISCLOSURE_REPORTER_EMAIL=security@nexusshield.ai
