# Supabase (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# Stripe (Developers → API keys / Webhooks)
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_signing_secret
# Optional: Stripe Price IDs (recurring). Falls back to inline price_data when unset.
STRIPE_PRO_MONTHLY_PRICE_ID=
STRIPE_PRO_YEARLY_PRICE_ID=
# Legacy alias for monthly price ID
STRIPE_PRO_PRICE_ID=

# Public base URL used to build Stripe success/cancel redirect URLs.
# Falls back to the request origin when unset.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# GitHub App (Settings → Developer settings → GitHub Apps → your app)
# Used to verify inbound webhook deliveries and to authenticate as the app's
# installations when calling the Checks API.
GITHUB_WEBHOOK_SECRET=your_github_app_webhook_secret
GITHUB_APP_ID=your_github_app_id
# Paste the full PEM contents. If your host only supports single-line values,
# escape newlines as literal "\n" — app-client.ts un-escapes them at runtime.
GITHUB_APP_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----\n"
# The app's URL slug, e.g. "nexus-shield" from
# https://github.com/apps/nexus-shield. Public because it's used to build the
# "Connect GitHub App" install link in the browser.
NEXT_PUBLIC_GITHUB_APP_SLUG=your-github-app-slug
