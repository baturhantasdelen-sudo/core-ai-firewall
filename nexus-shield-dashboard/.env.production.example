# Nexus Shield Dashboard — Production Environment Variables
# Copy these into Vercel → Project Settings → Environment Variables (Production).

# ── Public (safe to expose to the browser) ──────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_APP_URL=https://your-production-domain.vercel.app
NEXT_PUBLIC_GITHUB_APP_SLUG=your-github-app-slug

# ── Supabase (server-only — never prefix with NEXT_PUBLIC_) ─────────────────
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Optional alias; falls back to NEXT_PUBLIC_SUPABASE_URL when unset.
# SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co

# ── GitHub App (server-only) ────────────────────────────────────────────────
GITHUB_APP_ID=123456
# PEM private key — paste with literal \n line breaks OR real newlines in Vercel UI.
GITHUB_APP_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----"
GITHUB_WEBHOOK_SECRET=your_webhook_secret

# ── Stripe (server-only) ────────────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_live_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...
# Recurring Price IDs for Pro ($59/mo and $588/yr billed as $49/mo)
STRIPE_PRO_MONTHLY_PRICE_ID=price_...
STRIPE_PRO_YEARLY_PRICE_ID=price_...
# Legacy alias — monthly price ID
STRIPE_PRO_PRICE_ID=price_...

# ── Optional: direct Postgres URL for migration scripts (not required at runtime)
# SUPABASE_DB_URL=postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres
