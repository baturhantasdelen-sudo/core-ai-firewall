{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "installCommand": "cd nexus-shield-dashboard && npm install",
  "buildCommand": "cd nexus-shield-dashboard && npm run build",
  "redirects": [
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "api.nexusshield.ai" }],
      "destination": "https://nexusshield.ai/:path*",
      "permanent": true
    }
  ]
}
